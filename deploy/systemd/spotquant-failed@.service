[Unit]
Description=Alert that the Spotquant %i session unit failed

[Service]
Type=oneshot
User=spotquant
Group=spotquant
EnvironmentFile=-/etc/spotquant/%i.env
EnvironmentFile=-/etc/spotquant/notify.env
WorkingDirectory=/opt/spotquant
ExecStart=/usr/bin/python3.13 -m spotquant notify-failure --config /etc/spotquant/%i.json --source %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spotquant-failed-%i
