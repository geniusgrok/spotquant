+        'preserved_evidence_sha256': protected,
+        'failed_original_control': {'raw_sha256': ORIGINAL_SHA, 'account': 'incumbent/base',
+                                    'excluded_from_accepted_inventory': True, 'original_artifact_preserved': True},
+        'helper_sha256': sha(Path(__file__))})
+
+
+if __name__ == '__main__':
+    main()
