+    for entry in ui['audits']:
+        bound(entry['path'], entry['sha256']); audit = read(entry['path'])
+        require(audit['all_examined_checks_passed'] and audit['all_reported_complete']
+                and audit['raw_sha256'] == entry['raw_sha256'], 'Failed unscaled audit')
+        ids = {(audit['kind'], 'unscaled', k, audit['raw_sha256']) for k in audit['accounts']}
+        require(not ids & unscaled_ids, 'Duplicate unscaled audit identity'); unscaled_ids |= ids
+    require(ui['account_count'] == 48 and unscaled_ids == identities(final, False), 'Unscaled48 final identity mismatch')
+    protected = {str(p): sha(p) for p in [final_path, OUT/'registered-final-repaired.command.json',
+        old_final, old_index_path, unscaled_index_path, original_path, original_receipt, manifest_path,
+        projection, retry, OUT/'risk-perp-incumbent-retry1.command.json', CHECKER,
+        OUT/'registered-calibration.json', OUT/'spot-project-calibration.json',
+        OUT/'registered-risk.json', OUT/'registered-risk.command.json',
+        OUT/'registered-combinations.json', OUT/'registered-combinations.command.json',
+        REVIEW/'financial-audit-risk-perp.json', REVIEW/'financial-audit-risk-perp.command.json',
+        REVIEW/'coin-actual-risk-strict-first-attempt.log', REVIEW/'coin-actual-risk-financial-review.md']}
+    return final, expected, reused, protected, derivation, projection, retry
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--final-report', required=True, type=Path)
+    parser.add_argument('--out', required=True, type=Path)
+    parser.add_argument('--execute', action='store_true', help='Run only two new independent audits after all preflight gates')
+    args = parser.parse_args()
+    final, expected, entries, protected, derivation, projection, retry = preflight(args.final_report, args.out)
+    if not args.execute:
+        print(json.dumps({'preflight_passed': True, 'executed': False, 'outputs_written': False})); return
+    entries += [audit_one(projection, 'risk-perp-retained4-repaired'), audit_one(retry, 'risk-perp-incumbent-retry1')]
+    observed = set()
