+    require(set(children) == {projection, retry}, 'Duplicate/missing manifest child')
+    projected = read(projection)
+    derivation = projection_check(original, projected, original_path, original_receipt)
+    del original; gc.collect()
+    rr = receipt(retry, OUT/'risk-perp-incumbent-retry1.command.json', OUT/'risk-perp-incumbent-retry1.run.log',
+                 COIN_SOURCE, COIN, 'research.alpha_perp')
+    for flag, value in [('--candidate', 'incumbent'), ('--scenario', 'base'),
+                        ('--risk-calibration', str(OUT/'registered-calibration.json'))]:
+        require(option(rr['command'], flag) == value, 'Retry economics differ')
+    require('--initial-cny' not in rr['command'] and '--start-offset-ms' not in rr['command'],
+            'Retry must retain registered default capital/offset')
+    replacement = read(retry)
+    require(set(replacement['results']) == {'incumbent'} and replacement['inputs']['candidates'] == {'incumbent': []},
+            'Retry is not the single actual incumbent')
+    meta = replacement['inputs']
+    require(meta['source'] == meta['measured_source'] == COIN_SOURCE and meta['risk_calibration_sha256'] == CAL_SHA
+            and meta['risk_profiles'] == {'incumbent': cal['profiles']['incumbent']}
+            and str(meta['initial_cny']) == '10000' and meta['start_offset_ms'] == 0,
+            'Retry source/profile/economics mismatch')
+    sys.path.insert(0, str(ANALYSIS))
+    from research import alpha_assessment as assessor
+    require(assessor.source_identity() == ANALYSIS_SOURCE, 'Immutable assessor full source identity changed')
+    assessor.equivalent_inputs(projected['inputs'], meta, 'perp')
+    require(replacement['conditions'] == projected['conditions'], 'Retry conditions differ')
+    actual_groups = {}
+    for child, bundle in [(projection, projected), (retry, replacement)]:
+        for candidate, scenes in bundle['results'].items():
+            require(set(scenes) == {'base'}, 'Unexpected repaired scenario')
