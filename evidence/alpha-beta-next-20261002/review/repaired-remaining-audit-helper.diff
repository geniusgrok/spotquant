+    reused = []; seen = set()
+    for entry in old['audits']:
+        if (entry['kind'], entry['stage']) not in {('spot', 'risk'), ('perp', 'sensitivity')}:
+            continue
+        ids = verify_audit(entry)
+        require(not seen & ids and ids <= expected and ids <= old_expected,
