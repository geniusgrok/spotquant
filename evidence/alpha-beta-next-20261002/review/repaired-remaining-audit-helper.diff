+            'Final sensitivity command/report differs')
+    unscaled_index_path = REVIEW/'financial-audit-unscaled-index.json'; ui = read(unscaled_index_path)
+    bound(unscaled_index_path, 'c1fdd880d44acd052a780a63aebcfd9df48d31367229692d6049d14bacbaae88')
