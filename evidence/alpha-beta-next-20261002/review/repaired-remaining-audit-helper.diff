+    del projected, replacement; gc.collect()
+    unscaled = OUT/'perp-singletons-retry1.json.gz'; bound(unscaled, UNSCALED_SHA)
+    original20 = read(unscaled)
+    for name in NAMES-{'compression-breakout'}:
+        require(actual_groups[name+'/base'] == assessor.evidence_fingerprints(original20['results'][name]['base'], 'perp'),
+                'Repaired unity evidence differs: '+name)
+    del original20; gc.collect()
+    old_index_path = REVIEW/'financial-audit-remaining-index.json'; old = read(old_index_path)
+    old_final = OUT/'registered-final.json'
+    receipt(old_final, OUT/'registered-final.command.json', OUT/'registered-final.run.log',
+            ANALYSIS_SOURCE, ANALYSIS, 'research.alpha_assessment')
+    bound(old_final, old['final_assessment_sha256'])
+    old_report = read(old_final)
+    require(old_report['risk_baseline_controls']['perp']['passed'] is False
+            and old_report['risk_baseline_controls']['perp']['rejections'] == ['unity_control_evidence_mismatch'],
+            'Original failed-control history was replaced')
+    bound(OUT/'registered-risk.json', '6854ef5fcfebb9e746c7a586f2122c7360d21ed2a40d573c73b8f6b8fee2bcfd')
+    old_expected = identities(old_report, require_valid=False)
+    require(old['account_count'] == 16 and old['final_inventory_exactly_reconciled'] is True,
