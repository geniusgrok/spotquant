+"""Explicit, one-shot financial audit of the source-pinned Coin control repair.
+
+Default is read-only preflight. --execute authorizes only the two independent
+checker subprocesses and NEW review outputs, never a producer or an account.
+"""
+import argparse
+import gc
+import gzip
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+from datetime import datetime
+
+sys.dont_write_bytecode = True
+
+REVIEW = Path('/workspace/btc-alpha-beta-next/review')
+OUT = Path('/workspace/scratch/alpha-beta-next')
+ANALYSIS = Path('/workspace/btc-alpha-beta-analysis/spotquant')
+COIN = Path('/workspace/btc-alpha-beta-next/coinquant')
+CHECKER = REVIEW/'independent_financial_audit.py'
+CHECKER_SHA = '492d46ff9bbff72f1291ad77988fbf8478b35fd880c818e1d3979a6215f1897c'
+ASSESSOR_SHA = 'a5bb0569f25e66b5aa660b0106d42c3ecffc7f30ebc5e2cf1b1216958ff43edf'
+COIN_SOURCE = {'git_head': 'acedaa43ca94223f24e2fe11851bbef74e032a69', 'dirty': False,
+               'python_sources_sha256': 'a6e3f30f02208ff7e604b6181c5d8fa7000fe7e30dbc3276fbcc93ffbb0ad227'}
+ANALYSIS_SOURCE = {'git_head': '99fcf005d2cb15c13bb37322b65ab2863b19d65e', 'dirty': False,
+                   'python_sources_sha256': '427f34ca3640cfa78f51173583af1d9c82f007baae155f3a992dcffb8171ad7b'}
+ORIGINAL_SHA = '3b958b2e92d8aefcf7b9f073a3916c325420a546cf7652203ce6692be5ee2446'
+UNSCALED_SHA = 'bf1d167979f4bb3d15925f0bcaf5337bd1cc0a17523628b3af0599875dc5a7c1'
+CAL_SHA = 'ed8c99295e71386a7cef300f7d101ea941e5a7a0147bc9038012d6cc58e23821'
+SPOT_CAL_SHA = 'd574693fe94480c598dc1698b008147267227385ada31df82eab9498d38e7b2b'
+BASE_AUDIT_SHA = '051fade57cea7f85e33b799a7302da3d3c2f9adfae490f1161bcdf30a3ba0555'
+SPOT_BASE_SHA = '7dbcf9eff66c804a2cddbdd45703735be5e308b9e1b78eb63b5c5fa0dc266455'
+NAMES = {'incumbent', 'fresh-entry', 'atr-trail', 'compression-breakout', 'single-topup'}
+RETAINED = NAMES - {'incumbent'}
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def sha(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def read(path):
+    path = Path(path)
+    with (gzip.open(path, 'rt') if path.suffix == '.gz' else path.open()) as stream:
+        return json.load(stream)
+
+
+def checksum(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
+
+
+def bound(path, digest):
+    require(Path(path).is_file() and sha(path) == digest, 'Evidence bytes differ: '+str(path))
+
+
+def option(command, flag):
+    require(command.count(flag) == 1, 'Missing/ambiguous option: '+flag)
+    index = command.index(flag)
+    require(index+1 < len(command), 'Missing option value: '+flag)
+    return command[index+1]
+
+
+def exclusive(path):
+    path = Path(path)
+    require(path.is_absolute() and path.parent == REVIEW and path.parent.resolve() == REVIEW,
+            'Output must be a direct absolute REVIEW file')
+    require(not path.exists() and not path.is_symlink(), 'Output already exists: '+str(path))
+
+
+def write(path, value):
+    exclusive(path)
+    with Path(path).open('x') as stream:
+        json.dump(value, stream, indent=2)
+        stream.write('\n')
+
+
+def receipt(raw, receipt_path, log_path, source, cwd, module):
+    result = read(receipt_path)
+    require(result['exit_code'] == 0 and result['source_head'] == source['git_head']
+            and result['cwd'] == str(cwd), 'Failed/wrong-source command receipt')
+    command = result['command']
+    require(option(command, '-m') == module and option(command, '--out') == str(raw),
+            'Receipt module/output mismatch')
+    bound(raw, result['output_sha256'])
+    bound(log_path, result['log_sha256'])
+    started = datetime.fromisoformat(result['started_utc'])
+    require(started.tzinfo is not None and result['elapsed_seconds'] > 0, 'Missing real dated execution')
+    return result
+
+
+def identities(final, remaining=True, require_valid=True):
+    result = set()
+    for key, account in final['accounts'].items():
+        parts = key.split('/')
+        require(not require_valid or (account['valid'] and not account['rejections']), 'Invalid final account: '+key)
+        risk = len(parts) == 4 and parts[1] == 'risk'
+        require(risk or len(parts) == 3, 'Unexpected final account key: '+key)
+        if risk == remaining:
+            kind = parts[0]
+            account_key = account['candidate']+'/'+account['scenario']
+            require('/'.join(parts[-2:]) == account_key, 'Final account label mismatch')
+            result.add((kind, 'risk' if risk else 'unscaled', account_key, account['raw_bundle_sha256']))
+    if remaining:
+        for item in final['sensitivity']:
+            account = item['account']
+            require(not require_valid or (account['valid'] and not account['rejections']), 'Invalid final sensitivity')
+            require(item['raw_sha256'] == account['raw_bundle_sha256'], 'Sensitivity raw identity conflict')
+            result.add(('perp', 'sensitivity', account['candidate']+'/'+account['scenario'], item['raw_sha256']))
+        require(len(final['sensitivity']) == 4 and len(result) == 16, 'Expected exact12 risk +4 sensitivity')
+    else:
+        require(len(result) == 48, 'Expected exact48 unscaled')
+    return result
+
+
+def projection_check(original, projected, original_path, original_receipt):
+    """Only results/candidates narrowing plus explicit derivation is permitted."""
+    require(set(original['results']) == NAMES and set(projected['results']) == RETAINED,
+            'Projection candidate inventory differs')
+    expected = dict(original)
+    expected['results'] = {n: original['results'][n] for n in RETAINED}
+    expected['inputs'] = dict(original['inputs'])
+    expected['inputs']['candidates'] = {n: original['inputs']['candidates'][n] for n in RETAINED}
+    expected['derivation'] = {'kind': 'lossless-account-projection',
+        'original_bundle_path': str(original_path), 'original_bundle_sha256': sha(original_path),
+        'original_receipt_path': str(original_receipt), 'original_receipt_sha256': sha(original_receipt),
+        'retained_row_sha256': {n+'/base': checksum(original['results'][n]['base']) for n in RETAINED}}
+    require(projected == expected, 'Projection altered retained rows/metadata or derivation')
+    return expected['derivation']
+
+
+def final_gates(final, command):
+    require(command.count('--final') == 1, 'Final command missing exact --final')
+    require(final['analysis_source'] == ANALYSIS_SOURCE and not final['pending']
+            and not final['registered_work_pending'] and not final['risk_accounts_pending']
+            and final['all_measured_accounts_valid'] is True and final['rules_freeze_ready'] is True
+            and final['actual_account_days'] == 0 and final['native_cases'] == 0
+            and final['prospective_alpha_proven'] is False,
+            'Repaired final is incomplete/invalid or claims native evidence')
+    for kind in ('spot', 'perp'):
+        control = final['risk_baseline_controls'][kind]
+        require(control['passed'] is True and not control['rejections']
+                and set(control['evidence_checks']) == {'financial', 'fills', 'daily', 'ownership', 'operating', 'remaining_original_fields'}
+                and all(control['evidence_checks'].values()), 'Final unity control failed')
+    return identities(final)
+
+
+def context(kind, stage):
+    if stage != 'risk':
+        return {}
+    spot = kind == 'spot'
+    cal = OUT/('spot-project-calibration.json' if spot else 'registered-calibration.json')
+    base = REVIEW/('financial-audit-spot-unscaled-comparison.json' if spot else 'financial-audit-perp-singletons.json')
+    bound(cal, SPOT_CAL_SHA if spot else CAL_SHA)
+    bound(base, SPOT_BASE_SHA if spot else BASE_AUDIT_SHA)
+    return {'calibration': {'path': str(cal), 'sha256': sha(cal)},
+            'baseline_audit': {'path': str(base), 'sha256': sha(base)},
+            'unscaled_audit': {'path': str(base), 'sha256': sha(base)}}
+
+
+def verify_audit(entry):
+    raw, target = Path(entry['raw_path']), Path(entry['audit_path'])
+    bound(raw, entry['raw_sha256']); bound(target, entry['audit_sha256'])
+    command_receipt = target.with_suffix('.command.json')
+    r = read(command_receipt); command = r['command']
+    require(r['exit_code'] == 0 and r['checker_sha256'] == CHECKER_SHA, 'Wrong/failed independent checker')
+    bound(target.with_suffix('.run.log'), r['log_sha256'])
+    bound(target, r['output_sha256'])
+    ctx = context(entry['kind'], entry['stage'])
+    require(r['verification_context'] == ctx, 'Audit verification context mismatch')
+    expected = [command[0], str(CHECKER), '--bundle', str(raw), '--sha256', sha(raw),
+                '--kind', entry['kind'], '--out', str(target)]
+    for flag, name in [('calibration', 'calibration'), ('baseline-audit', 'baseline_audit'), ('unscaled-audit', 'unscaled_audit')]:
+        if name in ctx:
+            expected += ['--'+flag, ctx[name]['path']]
+    require(command == expected, 'Audit command differs from exact verification context')
+    report = read(target)
+    keys = sorted(report['accounts'])
+    require(report['raw_sha256'] == sha(raw) and report['kind'] == entry['kind']
+            and report['raw_path'] == str(raw), 'Audit raw identity differs')
+    require(report['all_examined_checks_passed'] is True and report['all_reported_complete'] is True
+            and entry['all_checks_passed'] is True and entry['all_reported_complete'] is True,
+            'Incomplete/failed audit')
+    require(keys == entry['account_keys'] and len(keys) == entry['accounts'], 'Audit inventory differs')
+    for account in report['accounts'].values():
+        require(account['reported_complete'] and account['producer_audit_passed']
+                and account['independent_checks_passed'] and not account['errors'], 'Failed per-account audit')
+    return {(entry['kind'], entry['stage'], k, entry['raw_sha256']) for k in keys}
+
+
+def audit_one(raw, label):
+    target = REVIEW/('financial-audit-'+label+'.json')
+    bound(CHECKER, CHECKER_SHA)
+    for path in (target, target.with_suffix('.command.json'), target.with_suffix('.run.log')):
+        exclusive(path)
+    command = [sys.executable, str(CHECKER), '--bundle', str(raw), '--sha256', sha(raw),
+               '--kind', 'perp', '--out', str(target)]
+    ctx = context('perp', 'risk')
+    for flag, name in [('calibration', 'calibration'), ('baseline-audit', 'baseline_audit'), ('unscaled-audit', 'unscaled_audit')]:
+        command += ['--'+flag, ctx[name]['path']]
+    started = time.monotonic()
+    with target.with_suffix('.run.log').open('x') as stream:
+        result = subprocess.run(command, stdout=stream, stderr=subprocess.STDOUT,
+                                env=dict(os.environ, PYTHONDONTWRITEBYTECODE='1'))
+    write(target.with_suffix('.command.json'), {'command': command, 'checker_sha256': CHECKER_SHA,
+        'elapsed_seconds': time.monotonic()-started, 'exit_code': result.returncode,
+        'log_sha256': sha(target.with_suffix('.run.log')), 'output_sha256': sha(target) if target.exists() else None,
+        'verification_context': ctx})
+    require(result.returncode == 0, 'New independent audit failed; all outputs retained')
+    report = read(target)
+    entry = {'label': label, 'raw_path': str(raw), 'raw_sha256': sha(raw), 'audit_path': str(target),
+             'audit_sha256': sha(target), 'kind': 'perp', 'stage': 'risk',
+             'account_keys': sorted(report['accounts']), 'accounts': len(report['accounts']),
+             'all_checks_passed': report['all_examined_checks_passed'],
+             'all_reported_complete': report['all_reported_complete']}
+    verify_audit(entry)
+    return entry
+
+
+def preflight(final_path, output):
+    require(final_path == OUT/'registered-final-repaired.json', 'Unexpected repaired final path')
+    require(output == REVIEW/'financial-audit-remaining-repaired-index.json', 'Unexpected repaired index path')
+    exclusive(output)
+    for label in ('risk-perp-retained4-repaired', 'risk-perp-incumbent-retry1'):
+        target = REVIEW/('financial-audit-'+label+'.json')
+        for path in (target, target.with_suffix('.command.json'), target.with_suffix('.run.log')):
+            exclusive(path)
+    bound(CHECKER, CHECKER_SHA); bound(ANALYSIS/'research/alpha_assessment.py', ASSESSOR_SHA)
+    final_receipt = receipt(final_path, OUT/'registered-final-repaired.command.json',
+                            OUT/'registered-final-repaired.run.log', ANALYSIS_SOURCE, ANALYSIS, 'research.alpha_assessment')
+    final = read(final_path)
+    expected = final_gates(final, final_receipt['command'])
+    original_path = OUT/'risk-perp.json.gz'; original_receipt = OUT/'risk-perp.command.json'
+    bound(original_path, ORIGINAL_SHA)
+    receipt(original_path, original_receipt, OUT/'risk-perp.run.log', COIN_SOURCE, COIN, 'research.alpha_perp')
+    original = read(original_path)
+    require(original['inputs']['source'] == original['inputs']['measured_source'] == COIN_SOURCE,
+            'Original measured source differs')
+    bound(OUT/'registered-calibration.json', CAL_SHA)
+    cal = read(OUT/'registered-calibration.json')
+    manifest_path = OUT/'risk-perp-repaired-manifest.json'
+    require(option(final_receipt['command'], '--risk-perp') == str(manifest_path), 'Final used wrong risk input')
+    bound(manifest_path, final['inputs']['risk_perp']['raw_sha256'])
+    require(final['inputs']['risk_perp']['path'] == str(manifest_path), 'Final manifest path differs')
+    manifest = read(manifest_path)
+    require(manifest['format'] == 'alpha-account-manifest-v1' and manifest['kind'] == 'perp'
+            and len(manifest['files']) == 2, 'Expected one-level two-child manifest')
+    projection = OUT/'risk-perp-retained4-projection.json.gz'
+    retry = OUT/'risk-perp-incumbent-retry1.json.gz'
