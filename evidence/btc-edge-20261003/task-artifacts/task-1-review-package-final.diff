+def generate(evidence):
+    evidence = Path(evidence).resolve()
+    bindings = []
+    def load(path, expected=None):
+        body, digest = read_json(path, expected)
+        bindings.append({'path': str(path), 'sha256': digest})
+        return body
+    def resolve(old):
+        if '/alpha-beta-next/' in old:
+            relative = Path('scratch') / old.split('/alpha-beta-next/', 1)[1]
+        elif '/btc-alpha-beta-next/review/' in old:
+            relative = Path('review') / old.split('/btc-alpha-beta-next/review/', 1)[1]
+        else:
+            raise ValueError('unrecognized accepted evidence path: ' + old)
+        require('..' not in relative.parts, 'unsafe evidence path')
+        candidates = [evidence / relative, RETAINED / relative]
+        return next((p for p in candidates if p.is_file()), candidates[0])
+    proof = load(evidence / 'review/final64-financial-review-proof.json')
+    require(proof['financial_evidence_approved'] and proof['exact64_reconciled'], 'accepted final review required')
+    final = load(evidence / 'scratch/registered-final-repaired.json', proof['final_sha256'])
+    canonical_proof_path = evidence / 'review/spot-canonical-five-financial-proof.json'
+    canonical_proof = load(canonical_proof_path,
+        proof['identities']['/workspace/btc-alpha-beta-next/review/spot-canonical-five-financial-proof.json'])
+    require(canonical_proof['all_five_complete_and_six_groups_equal'], 'canonical bridge not accepted')
+    inventory = load(resolve('/workspace/scratch/alpha-beta-next/spot-canonical/canonical-inventory.json'),
+        canonical_proof['identities']['/workspace/scratch/alpha-beta-next/spot-canonical/canonical-inventory.json'])
+    base_files = [x for x in inventory['files'] if x['label'] == 'base' and not x['calibrated']]
+    require(len(base_files) == 1, 'ambiguous canonical base')
+    canonical = load(resolve('/workspace/scratch/alpha-beta-next/spot-canonical/' + base_files[0]['path']), base_files[0]['sha256'])
+    spot = canonical['results']['atr-stop-base']
+    atr_inputs = [x for x in final['inputs']['spot']['account_source_manifests']
+                  if x['raw_sha256'] == canonical_proof['identities']['/workspace/scratch/alpha-beta-next/spot-singletons/atr-stop.json.gz']]
+    require(len(atr_inputs) == 1, 'ambiguous accepted rich ATR input')
+    rich_bundle = load(resolve(atr_inputs[0]['path']), atr_inputs[0]['raw_sha256'])
+    rich = rich_bundle['results']['atr-stop-base']
+    for group in ('fills', 'daily', 'allocations', 'positions', 'cash_usdt', 'btc'):
+        require(spot[group] == rich[group], 'canonical/rich mismatch: ' + group)
+    perp_input = final['inputs']['perp']
+    require(proof['identities'][perp_input['path']] == perp_input['raw_sha256'], 'Coin original outside accepted review')
+    original_bundle = load(resolve(perp_input['path']), perp_input['raw_sha256'])
+    original = original_bundle['results']['incumbent']['base']
+    comparisons, sources = {}, {'spot_canonical': canonical['source'], 'spot_rich': rich_bundle['source'],
+                                'coin_original': original_bundle['inputs']['source']}
+    for offset in (-60000, 60000):
+        sensitivity = [r for r in final['sensitivity'] if r['candidate'] == 'incumbent' and
+                       r['initial_cny'] == '10000' and r['start_offset_ms'] == offset]
+        require(len(sensitivity) == 1, 'ambiguous accepted Coin sensitivity')
+        identity = [p for p, h in proof['identities'].items() if h == sensitivity[0]['raw_sha256']]
+        require(len(identity) == 1, 'sensitivity outside accepted inventory')
+        shifted_bundle = load(resolve(identity[0]), sensitivity[0]['raw_sha256'])
+        require(shifted_bundle['inputs']['start_offset_ms'] == offset and
+                shifted_bundle['inputs']['source'] == sources['coin_original'], 'Coin source/offset mismatch')
+        comparisons[str(offset)] = coin_comparison(original, shifted_bundle['results']['incumbent']['base'])
+        sources['coin_' + str(offset)] = shifted_bundle['inputs']['source']
+    prior_root = evidence.parent / 'complete-delivery-20261001'
+    manifest = load(prior_root / 'manifest.json')
+    prior = load(prior_root / 'assessment.json',
+                 manifest['files']['evidence/complete-delivery-20261001/assessment.json']['sha256'])
+    prior_rows = {k: v for k, v in prior['candidate_attribution'].items()
+                  if k.startswith(('spot/funding-', 'spot/basis-', 'spot/default-', 'perp/funding-filter/',
+                                   'perp/basis-filter/', 'perp/incumbent/'))}
+    selections = {'spot': {k: prior['spot_selection']['decisions'][k] for k in ('funding', 'basis')},
+                  'perp': {k: prior['perp_selection']['decisions'][k] for k in ('funding-filter', 'basis-filter')}}
+    for binding in bindings:
+        require(sha(binding['path']) == binding['sha256'], 'input changed during attribution')
+    return {'format': 'edge-attribution-v1', 'diagnostic_source': {
+                'git_head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
+                'module_sha256': sha(__file__), 'follow_sha256': sha(ROOT / 'spotquant/follow.py'),
+                'preview_sha256': sha(ROOT / 'spotquant/preview.py')},
+            'inputs': bindings, 'measured_sources': sources,
+            'spot': spot_attribution(spot, rich), 'coin': comparisons,
+            'prior_funding_basis': {'analysis_source': prior['analysis_source'], 'rows': prior_rows,
+                'selection': selections,
+                'conclusion': 'All four prior simple filters were ineligible; negative evidence is retained.',
+                'remaining_questions': ['Trend-conditioned funding/basis interactions require a separately registered causal test.',
+                    'Coin holding-horizon funding awareness is distinct from a simple entry filter.',
+                    'Risk budgets and Spot ordinary-exit confirmation are distinct mechanisms; old filters do not answer them.',
+                    'Reusing a previously rejected simple filter or tuning thresholds to this history is not justified.']},
+            'financial_producer_executed': False, 'native_cases': 0, 'actual_account_days': 0,
+            'limitations': ['Accepted financial reviews are consumed, not re-executed or independently reconstructed here.',
+                            'Historical proxy evidence is contaminated by prior research; no prospective alpha or native qualification.']}
+
+
+def markdown(body):
+    lines = ['# Existing-evidence attribution', '',
+             'Read-only accepted evidence. Price opportunity is not earned profit. Native cases/account days: 0/0.', '',
+             '## Spot', '', 'Exit sleeve counts: ' + json.dumps(body['spot']['exit_sleeve_counts']),
+             'Flat sleeve-day counts: ' + json.dumps(body['spot']['flat_sleeve_day_counts']), '',
+             'Flat denotes closed campaigns with proven retained dust; daily endpoints do not prove intraday flatness.', '',
+             '## Coin', '']
+    for offset, result in body['coin'].items():
+        lines += [offset + 'ms first divergence counts: ' + json.dumps(result['first_divergence_counts']),
+                  'First account operational divergence: ' + json.dumps(result['first_account_operational_divergence']), '']
+    lines += ['No unnecessary dependency is established. Raw timestamps/values and per-opportunity stage traces are in JSON.', '',
+              '## Prior funding/basis', '', body['prior_funding_basis']['conclusion'], '']
+    lines += ['- ' + x for x in body['prior_funding_basis']['remaining_questions']]
+    lines += ['', '## Input byte bindings', '']
+    lines += ['- `' + x['sha256'] + '` ' + x['path'] for x in body['inputs']]
+    lines += ['', '## Limits', '']
+    lines += ['- ' + x for x in body['limitations'] + body['spot']['limitations'] + body['coin']['-60000']['limitations']]
+    return '\n'.join(lines) + '\n'
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--evidence', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    args = parser.parse_args(argv)
+    require(not args.out.exists(), 'output already exists')
+    body = generate(args.evidence)
+    # mkdir without exist_ok plus exclusive file opens rejects race/overwrite.
+    args.out.mkdir()
+    with (args.out / 'attribution.json').open('x', encoding='utf-8') as stream:
+        json.dump(body, stream, indent=2, allow_nan=False)
+        stream.write('\n')
+    with (args.out / 'attribution.md').open('x', encoding='utf-8') as stream:
+        stream.write(markdown(body))
+
+
+if __name__ == '__main__':
+    main()
