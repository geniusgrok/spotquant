+    def book(self, a, reseal=False):
+        if reseal:
+            seal(a)
+        self.path.write_bytes(edge._canonical(a) + b'\n')
+        return edge.FeatureBook(self.path)
+
+    def valid(self):
+        return artifact([row('funding', edge.START_MS, '-.0002')],
+                        [row('basis', edge.START_MS, '.011')])
