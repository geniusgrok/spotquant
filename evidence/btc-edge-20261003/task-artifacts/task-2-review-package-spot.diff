+  },
+  "added_cash": "0",
+  "adoption": {
+    "annualization": "each original producer year convention, explicitly retained",
+    "base_improvement": "CAGR >= baseline + .01 OR (continuous MDD <= baseline - .01 AND CAGR >= baseline - .01)",
+    "base_worst_cny_day_min": "baseline - .005",
+    "combination": "all individually eligible compatible mechanisms, no subset search; all four stresses and actual calibrated base; adopt only own gates pass",
+    "complete_known_audited_original_matched_stresses": true,
+    "each_scenario_cagr_min": "baseline - .01",
