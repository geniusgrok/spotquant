<script>
window.onscroll = function() {scrollFunction()};
function scrollFunction() {
  if (document.body.scrollTop > 50 || document.documentElement.scrollTop > 50) {
	document.getElementById("logosize").style.width = "100px";
	document.getElementById("logosize").style.height = "48px";
	document.getElementById("headercss").style.opacity = "0.8";
  } else {
	document.getElementById("logosize").style.width = "240px";
	document.getElementById("logosize").style.height = "115px";	
	document.getElementById("headercss").style.opacity = "1";		
  }
}
</script>

