    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                // GBTC placed first so it stacks downward into the negative area
                {
                    label: 'GBTC',
                    data: seriesData['GBTC'],
                    borderColor: '#808080',
                    backgroundColor: '#808080', // Solid grey
                    fill: true,
                    stack: 'funds',
                    borderWidth: 1,
                    pointRadius: 0,
                    pointHoverRadius: 0,
