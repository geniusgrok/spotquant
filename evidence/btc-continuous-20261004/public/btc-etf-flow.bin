                    borderColor: '#39FF14', // Bright Neon Green
                    backgroundColor: 'transparent',
                    fill: false,
                    stack: 'totalLine', // Unlinks from the area stacking
                    borderWidth: 3, 
                    pointRadius: 0,
                    pointHoverRadius: 0,
                    tension: 0.1,
                    order: 0 // Forces Chart.js to draw this line ON TOP of the filled areas
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    ticks: {
                        maxRotation: 0,
                        minRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 8
                    },
                    grid: {
                        display: false
                    }
                },
                y: {
                    stacked: true,
                    grid: {
                        color: '#eaeffa'
                    },
                    ticks: {
                        callback: function(value) {
                            // Format negative numbers with parentheses on the Y-axis
                            if (value < 0) {
                                return '(' + Math.abs(value).toLocaleString('en-US') + ')';
                            }
                            return value.toLocaleString('en-US');
                        }
                    }
                }
            },
            plugins: {
                title: {
                    display: true,
                    text: 'Bitcoin Spot ETF Cumulative Flow (US$m)',
                    font: {
                        size: 16,
                        weight: 'bold'
                    },
                    padding: {
                        top: 10,
                        bottom: 20
                    }
                },
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        boxWidth: 8
                    }
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                    itemSort: function(a, b) {
                        return a.datasetIndex - b.datasetIndex;
                    },
                    callbacks: {
                        label: function(context) {
                            let label = context.dataset.label || '';
                            if (label) {
                                label += ': ';
                            }
                            if (context.parsed.y !== null) {
                                let val = context.parsed.y;
                                // Format negative numbers with parentheses in the tooltip
                                if (val < 0) {
                                    label += '(' + Math.abs(val).toLocaleString('en-US', {
                                        minimumFractionDigits: 0,
                                        maximumFractionDigits: 1
                                    }) + ')';
                                } else {
                                    label += val.toLocaleString('en-US', {
                                        minimumFractionDigits: 0,
                                        maximumFractionDigits: 1
                                    });
                                }
                            }
                            return label;
                        }
                    }
                }
            },
            interaction: {
                mode: 'nearest',
                axis: 'x',
                intersect: false
            }
        }
    });
});
