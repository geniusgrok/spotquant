  opacity: 1;
  transition: 0.8s ease;
}

.my-fade1 {
  animation: fadein 2s;
}

.my-fade2 {
  animation: fadein 2s;
  animation-delay: 0.5s;
  animation-fill-mode: both;
}

.my-fade3 {
  animation: fadein 2s;
  animation-delay: 1s;
  animation-fill-mode: both;
}

.my-fade4 {
  animation: fadein 2s;
  animation-delay: 1.5s;
  animation-fill-mode: both;
}

@keyframes fadein {
  from { opacity: 0; }
  to   { opacity: 1; }
}

